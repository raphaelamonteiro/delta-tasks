# Copie para .env e ajuste conforme necessário:  cp .env.example .env

# ---- Ambiente ----
ENVIRONMENT=development

# ---- PostgreSQL ----
# POSTGRES_HOST: use "localhost" rodando fora do Docker.
# No docker-compose o serviço "app" sobrescreve para "db" automaticamente.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=delta_tasks

# ---- JWT / Segurança (TROQUE estes valores fora de desenvolvimento) ----
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_SIGNING_KEY=change-me-access
REFRESH_TOKEN_SIGNING_KEY=change-me-refresh
RESET_TOKEN_HMAC_SECRET=change-me-hmac

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=no_reply@deltatask.local

# ---- Uvicorn (compose) ----
# true ativa --reload no container app (use com bind mount do código).
UVICORN_RELOAD=false
